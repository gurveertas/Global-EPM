# ---- Database ----
# The API and worker connect as eszy_app (no BYPASSRLS), so row-level security always applies.
DATABASE_URL=postgres://eszy_app:CHANGE_ME@postgres:5432/eszy
# Migrations and seeding run as the owner role.
MIGRATION_DATABASE_URL=postgres://eszy_owner:CHANGE_ME@postgres:5432/eszy
REDIS_URL=redis://redis:6379

# ---- Domains ----
BASE_DOMAIN=eszy.com          # companies get <slug>.eszy.com; admin.eszy.com is the platform console
APP_URL_SCHEME=https
DEV_TENANT_HEADER=false       # true only in development (lets X-Tenant pick a company)

# ---- Secrets (generate with: openssl rand -base64 48) ----
JWT_SECRET=
APP_ENCRYPTION_KEY=           # encrypts stored keys: Google secrets, backup keys, Stripe/Razorpay keys

# ---- Email ----
MAIL_TRANSPORT=ses            # ses | smtp | log
MAIL_FROM="eszy <no-reply@eszy.com>"
AWS_REGION=ap-south-1         # SES region; uses the instance role or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
SMTP_URL=                     # only for MAIL_TRANSPORT=smtp, e.g. smtps://user:pass@smtp.example.com:465
SALES_EMAIL=sales@eszy.com    # where Contact sales enquiries are sent

# ---- Optional ----
GOOGLE_CLIENT_ID=             # default Google client for companies that turn Google sign-in on without their own
PLATFORM_ADMIN_EMAIL=owner@eszy.com   # first console login, created by the seed
PLATFORM_ADMIN_PASSWORD=
WORKER_CONCURRENCY=8
LOG_LEVEL=info
