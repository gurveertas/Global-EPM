# Copy to .env for local development (matches docker-compose.dev.yml).
NODE_ENV=development
DATABASE_URL=postgres://eszy_app:app@localhost:5432/eszy
MIGRATION_DATABASE_URL=postgres://eszy_owner:owner@localhost:5432/eszy
REDIS_URL=redis://localhost:6380
BASE_DOMAIN=eszy.com
APP_URL_SCHEME=http
WEB_PORT_SUFFIX=:5173
DEV_TENANT_HEADER=true
MAIL_TRANSPORT=log
PLATFORM_ADMIN_EMAIL=owner@eszy.com
PLATFORM_ADMIN_PASSWORD=change-me-now

# Optional platform-wide AI keys for the assistant (companies can add their own under Settings → Assistant)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
